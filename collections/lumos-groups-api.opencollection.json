{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lumos REST AccessPolicies Groups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lumos.com/groups"
          },
          "docs": "List groups"
        },
        {
          "info": {
            "name": "Get specific group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lumos.com/groups/:group_id",
            "params": [
              {
                "name": "group_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get specific group"
        },
        {
          "info": {
            "name": "List group members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lumos.com/groups/:group_id/users",
            "params": [
              {
                "name": "group_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List group members"
        }
      ]
    }
  ],
  "bundled": true
}