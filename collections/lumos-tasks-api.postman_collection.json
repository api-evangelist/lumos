  "info": {
    "_postman_id": "0ab7587f-9707-43a6-af41-325a5e0d9bcf",
    "name": "Lumos REST AccessPolicies Tasks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Lumos REST API enables programmatic access to the Lumos identity\nplatform for automating user, group, app, account, access policy, access\nrequest, access review, pre-approval rule, task, vendor agreement, and\nactivity log management. All requests use a Bearer token (prefixed `lsk_`)\nin the Authorization header.\n\n\nContact Support:\n Name: Lumos Developers",
      "type": "text/plain"
    }
  }
