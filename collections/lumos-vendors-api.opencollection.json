            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload discovered documents"
        },
        {
          "info": {
            "name": "Upload order information",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.lumos.com/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload order information"
        }
      ]
    }
