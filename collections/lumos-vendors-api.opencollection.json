              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update vendor agreement custom attribute"
        },
        {
          "info": {
            "name": "Upload discovered documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
